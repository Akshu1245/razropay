# Optional bounded interpreter modes.
#
# The deterministic benchmarks, demos, release gates and tests run with none of
# these set. Live-model settings are only for explicit evidence runs. Models
# are interpretation services: they cannot authorize a payment action, change
# consent, or reach the provider. Those boundaries live in deterministic code.

# Existing MandateGuard B3 interpreter. Never commit a real key.
OPENAI_API_KEY=
MANDATEGUARD_INTERPRETER_BASE_URL=
MANDATEGUARD_INTERPRETER_MODEL=
MANDATEGUARD_MODEL_INPUT_USD_PER_1M=
MANDATEGUARD_MODEL_OUTPUT_USD_PER_1M=
MANDATEGUARD_USD_TO_INR=
MANDATEGUARD_OFFLINE=1

# RecoveryTruth state resolver. These may point to any legitimate
# OpenAI-compatible endpoint. Keep credentials in your shell / CI secrets,
# never in this file or a committed config.
RECOVERYTRUTH_RESOLVER_API_KEY=
RECOVERYTRUTH_RESOLVER_BASE_URL=
RECOVERYTRUTH_RESOLVER_MODEL=

# Razorpay Test Mode read-before-act evidence. Use Test Mode credentials only
# for hackathon evidence capture; never commit the values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com
